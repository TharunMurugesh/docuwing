# ── Stage 1: Base ──────────────────────────────────────────────────────
FROM python:3.11-slim AS base

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# ── Stage 2: Dependencies ──────────────────────────────────────────────
FROM base AS deps

# Install engine package first (dependency of API)
COPY packages/engine/pyproject.toml packages/engine/
COPY packages/engine/docuwing_engine/ packages/engine/docuwing_engine/
RUN pip install --no-cache-dir -e packages/engine

# Install API dependencies
COPY apps/api/pyproject.toml apps/api/
RUN pip install --no-cache-dir -e apps/api

# ── Stage 3: Runtime ──────────────────────────────────────────────────
FROM deps AS runtime

COPY apps/api/ apps/api/
COPY packages/engine/ packages/engine/

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
